{
  "manifest_version": 3,
  "name": "DGhost Trade",
  "version": "1.0.0",
  "description": "Создаёт обмен в Steam с проданным на DGhostMarket скином — остаётся подтвердить в Steam Guard.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/tradeoffer/new/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
